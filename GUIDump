local lastY = os.clock()
local function setProgress(p, msg)
    p = math.clamp(p, 0, 100)
    fill.Size = UDim2.fromScale(p / 100, 1)
    pctLbl.Text = string.format("%d%%", math.floor(p))
    if msg then status.Text = msg end
    if os.clock() - lastY > 0.03 then task.wait(); lastY = os.clock() end
end

