--[[
    GUI Dumper v2 -> .rbxm   (Delta)
    Dump : semua GUI (PlayerGui, StarterGui, ReplicatedFirst, Billboard/SurfaceGui, nil)
           + semua script yang menjalankan UI itu (decompile), jadi satu file
    Output (folder workspace Delta):
        GuiDump.rbxm  (+ salinan GuiDump.rbxmx), report.txt, scripts/*.lua, images/* (opsional)
]]

local CFG = {
    OutName          = "GuiDump",
    IncludeCoreGui   = false, -- true = CoreGui ikut di-dump (berat)
    IncludeNil       = true,
    ScanReferences   = true,  -- cari script lain yang nyebut nama GUI di source-nya
    DownloadImages   = false, -- true = file gambar ikut diunduh ke GuiDump/images (bisa diubah dari UI)
    MaxImages        = 300,
    DisableScripts   = true,  -- LocalScript di dalam dump dimatiin biar aman dibuka di Studio
    SaveLooseLua     = true,
    DecompileTimeout = 15,
}

